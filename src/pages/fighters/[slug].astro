---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import DivisionChip from '../../components/DivisionChip.astro';
import RecordBadge from '../../components/RecordBadge.astro';
import fs from 'fs';
import path from 'path';

export function getStaticPaths() {
  const fightersDir = path.join(process.cwd(), 'data/fighters');
  const fighterFiles = fs.readdirSync(fightersDir).filter(f => f.endsWith('.json'));

  return fighterFiles.map(file => {
    const fighter = JSON.parse(fs.readFileSync(path.join(fightersDir, file), 'utf-8'));
    return {
      params: { slug: fighter.id },
      props: { fighter }
    };
  });
}

const { fighter } = Astro.props;

// Check if fighter has a real image
const hasImage = fighter.image && fighter.image !== '/images/fighters/placeholder.jpg';
const initials = `${fighter.firstName[0]}${fighter.lastName[0]}`.toUpperCase();

// Load division
const divisions = JSON.parse(fs.readFileSync(path.join(process.cwd(), 'data/divisions.json'), 'utf-8'));
const division = divisions.find((d: any) => d.id === fighter.divisionId);

// Load record
const recordsPath = path.join(process.cwd(), 'generated/records.json');
const records = fs.existsSync(recordsPath)
  ? JSON.parse(fs.readFileSync(recordsPath, 'utf-8'))
  : [];
const record = records.find((r: any) => r.fighterId === fighter.id) || { wins: 0, losses: 0, draws: 0, koWins: 0, subWins: 0 };

// Load bio
let bio = '';
// Try to load bio file - either from bioFile field or by fighter ID
const bioFileName = fighter.bioFile || `${fighter.id}.md`;
const bioPath = path.join(process.cwd(), 'data/fighters/bios', bioFileName);
if (fs.existsSync(bioPath)) {
  bio = fs.readFileSync(bioPath, 'utf-8');
}

// Load fight history
const boutsPath = path.join(process.cwd(), 'public/bouts.json');
const bouts = fs.existsSync(boutsPath)
  ? JSON.parse(fs.readFileSync(boutsPath, 'utf-8'))
  : [];

const resultsPath = path.join(process.cwd(), 'public/results.json');
const results = fs.existsSync(resultsPath)
  ? JSON.parse(fs.readFileSync(resultsPath, 'utf-8'))
  : [];

const eventsPath = path.join(process.cwd(), 'public/events.json');
const events = fs.existsSync(eventsPath)
  ? JSON.parse(fs.readFileSync(eventsPath, 'utf-8'))
  : [];

const fightersPath = path.join(process.cwd(), 'public/fighters.json');
const allFighters = fs.existsSync(fightersPath)
  ? JSON.parse(fs.readFileSync(fightersPath, 'utf-8'))
  : [];

// Get all bouts involving this fighter
const fighterBouts = bouts.filter((bout: any) =>
  bout.fighter1Id === fighter.id || bout.fighter2Id === fighter.id
);

// Build fight history with full details
const fightHistory = fighterBouts.map((bout: any) => {
  const result = results.find((r: any) => r.boutId === bout.id);
  const event = events.find((e: any) => e.id === bout.eventId);
  const opponentId = bout.fighter1Id === fighter.id ? bout.fighter2Id : bout.fighter1Id;
  const opponent = allFighters.find((f: any) => f.id === opponentId);

  const isWinner = result?.winnerId === fighter.id;
  const score = result?.score || 'N/A';

  // Calculate points earned based on scoring system
  let pointsEarned = 0;
  if (isWinner) {
    if (score === '2-0') {
      pointsEarned = 3; // Dominant victory
    } else if (score === '2-1') {
      pointsEarned = 2; // Hard-fought victory
    }
  }

  return {
    boutId: bout.id,
    eventId: bout.eventId,
    eventTitle: event?.title || 'Unknown Event',
    eventDate: event?.date || '',
    opponentName: opponent ? `${opponent.firstName} ${opponent.lastName}` : 'Unknown',
    opponentNickname: opponent?.nickname,
    isWinner,
    score,
    method: result?.method || 'N/A',
    pointsEarned,
    forChampionship: bout.forChampionship || false,
  };
}).sort((a: any, b: any) => {
  // Sort by event date, most recent first
  return new Date(b.eventDate).getTime() - new Date(a.eventDate).getTime();
});
---

<BaseLayout title={`${fighter.firstName} ${fighter.lastName}`} description={`Fighter profile for ${fighter.firstName} ${fighter.lastName}`}>
  <PageHeader title={`${fighter.firstName} ${fighter.lastName}`} subtitle={fighter.nickname ? `"${fighter.nickname}"` : undefined} />

  <section class="py-16">
    <div class="container mx-auto px-4 max-w-4xl">
      <div class="bg-white rounded-2xl shadow-lg overflow-hidden border-2 border-bourbon">
        <!-- Fighter Image -->
        <div class="aspect-[32/9] md:aspect-[42/9] overflow-hidden relative bg-gray-100">
          {hasImage ? (
            <img
              src={fighter.image}
              alt={`${fighter.firstName} ${fighter.lastName}`}
              class="w-full h-full object-cover object-top"
            />
          ) : (
            <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-bourbon to-bourbon-dark">
              <span class="text-8xl md:text-9xl font-black text-white opacity-90">{initials}</span>
            </div>
          )}
        </div>

        <!-- Stats Header -->
        <div class="bg-gradient-to-r from-bourbon to-bourbon-dark text-white p-8">
          <div class="flex flex-wrap items-center justify-between gap-4">
            <div>
              <RecordBadge wins={record.wins} losses={record.losses} draws={record.draws} />
              <div class="mt-2 text-sm text-gray-200">
                {record.koWins} KO/TKO
              </div>
            </div>
            <DivisionChip division={division?.nickname || fighter.divisionId} size="lg" />
          </div>
        </div>

        <!-- Fighter Details -->
        <div class="p-8">
          <div class="grid md:grid-cols-2 gap-8 mb-8">
            <div>
              <h3 class="text-lg font-bold text-bourbon mb-4">Physical Stats</h3>
              <dl class="space-y-2 text-sm">
                <div class="flex justify-between">
                  <dt class="text-gray-600">Weight:</dt>
                  <dd class="font-semibold">{fighter.weight} lbs</dd>
                </div>
                {fighter.height && (
                  <div class="flex justify-between">
                    <dt class="text-gray-600">Height:</dt>
                    <dd class="font-semibold">{fighter.height}</dd>
                  </div>
                )}
                {fighter.reach && (
                  <div class="flex justify-between">
                    <dt class="text-gray-600">Reach:</dt>
                    <dd class="font-semibold">{fighter.reach}"</dd>
                  </div>
                )}
                {fighter.stance && (
                  <div class="flex justify-between">
                    <dt class="text-gray-600">Stance:</dt>
                    <dd class="font-semibold">{fighter.stance}</dd>
                  </div>
                )}
                {fighter.fightingStyle && (
                  <div class="flex justify-between">
                    <dt class="text-gray-600">Fighting Style:</dt>
                    <dd class="font-semibold">{fighter.fightingStyle}</dd>
                  </div>
                )}
                {fighter.coach && (
                  <div class="flex justify-between">
                    <dt class="text-gray-600">Coach:</dt>
                    <dd class="font-semibold">{fighter.coach}</dd>
                  </div>
                )}
              </dl>
            </div>

            <div>
              <h3 class="text-lg font-bold text-bourbon mb-4">Info</h3>
              <dl class="space-y-2 text-sm">
                {fighter.age && (
                  <div class="flex justify-between">
                    <dt class="text-gray-600">Age:</dt>
                    <dd class="font-semibold">{fighter.age}</dd>
                  </div>
                )}
                {(fighter.nationality || fighter.country) && (
                  <div class="flex justify-between">
                    <dt class="text-gray-600">Nationality:</dt>
                    <dd class="font-semibold">{fighter.nationality || fighter.country}</dd>
                  </div>
                )}
                {fighter.debut && (
                  <div class="flex justify-between">
                    <dt class="text-gray-600">Debut:</dt>
                    <dd class="font-semibold">{new Date(fighter.debut).toLocaleDateString()}</dd>
                  </div>
                )}
                <div class="flex justify-between">
                  <dt class="text-gray-600">Status:</dt>
                  <dd class="font-semibold">{fighter.active ? 'Active' : 'Inactive'}</dd>
                </div>
              </dl>
            </div>
          </div>

          <!-- Bio -->
          {bio && (
            <div class="prose prose-sm max-w-none">
              <div set:html={bio} class="text-gray-700 leading-relaxed whitespace-pre-wrap" />
            </div>
          )}
        </div>
      </div>

      <!-- Fight History -->
      {fightHistory.length > 0 && (
        <div class="bg-white rounded-2xl shadow-lg overflow-hidden border-2 border-bourbon mt-8">
          <div class="bg-gradient-to-r from-bourbon to-bourbon-dark text-white p-6">
            <h2 class="text-2xl font-black">Fight History</h2>
          </div>
          <div class="p-6">
            <div class="space-y-4">
              {fightHistory.map((fight: any) => (
                <div class="border-2 border-gray-200 rounded-xl p-4 hover:border-bourbon transition">
                  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                    <!-- Event & Opponent Info -->
                    <div class="flex-1">
                      <div class="flex items-center gap-2 mb-2">
                        <span class="text-sm font-semibold text-gray-600">{fight.eventTitle}</span>
                        {fight.forChampionship && (
                          <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-bold bg-yellow-100 text-yellow-800 border border-yellow-300">
                            TITLE FIGHT
                          </span>
                        )}
                      </div>
                      <div class="text-lg font-bold text-gray-900">
                        vs {fight.opponentName}
                        {fight.opponentNickname && (
                          <span class="text-sm text-gray-500 font-normal ml-2">"{fight.opponentNickname}"</span>
                        )}
                      </div>
                      <div class="text-xs text-gray-500 mt-1">
                        {new Date(fight.eventDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                      </div>
                    </div>

                    <!-- Result Details -->
                    <div class="flex items-center gap-4">
                      <!-- Result Badge -->
                      <div class={`px-4 py-2 rounded-lg font-bold text-center min-w-[80px] ${
                        fight.isWinner
                          ? 'bg-green-100 text-green-800 border-2 border-green-300'
                          : 'bg-red-100 text-red-800 border-2 border-red-300'
                      }`}>
                        {fight.isWinner ? 'WIN' : 'LOSS'}
                      </div>

                      <!-- Score & Method -->
                      <div class="text-center">
                        <div class="text-2xl font-black text-bourbon">{fight.score}</div>
                        <div class="text-xs text-gray-600 uppercase">{fight.method}</div>
                      </div>

                      <!-- Points Earned -->
                      <div class="text-center bg-gray-50 rounded-lg px-4 py-2 border-2 border-gray-200 min-w-[80px]">
                        <div class={`text-2xl font-black ${fight.pointsEarned > 0 ? 'text-green-600' : 'text-gray-400'}`}>
                          {fight.pointsEarned > 0 ? '+' : ''}{fight.pointsEarned}
                        </div>
                        <div class="text-xs text-gray-600 uppercase">Points</div>
                      </div>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
