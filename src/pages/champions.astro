---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import DivisionChip from '../components/DivisionChip.astro';
import RecordBadge from '../components/RecordBadge.astro';
import fs from 'fs';
import path from 'path';

// Load belts data
const beltsPath = path.join(process.cwd(), 'data/belts.json');
const belts = JSON.parse(fs.readFileSync(beltsPath, 'utf-8'));

// Load all fighters
const fightersDir = path.join(process.cwd(), 'data/fighters');
const fighterFiles = fs.readdirSync(fightersDir).filter(f => f.endsWith('.json'));
const allFighters = fighterFiles.map(f =>
  JSON.parse(fs.readFileSync(path.join(fightersDir, f), 'utf-8'))
);

// Load divisions
const divisions = JSON.parse(fs.readFileSync(path.join(process.cwd(), 'data/divisions.json'), 'utf-8'));

// Load records
const recordsPath = path.join(process.cwd(), 'generated/records.json');
const records = fs.existsSync(recordsPath)
  ? JSON.parse(fs.readFileSync(recordsPath, 'utf-8'))
  : [];
const recordsMap = new Map(records.map((r: any) => [r.fighterId, r]));

// Load events for championship details
const eventsPath = path.join(process.cwd(), 'public/events.json');
const events = fs.existsSync(eventsPath)
  ? JSON.parse(fs.readFileSync(eventsPath, 'utf-8'))
  : [];

// Load bouts and results for fight history
const boutsPath = path.join(process.cwd(), 'public/bouts.json');
const bouts = fs.existsSync(boutsPath)
  ? JSON.parse(fs.readFileSync(boutsPath, 'utf-8'))
  : [];

const resultsPath = path.join(process.cwd(), 'public/results.json');
const results = fs.existsSync(resultsPath)
  ? JSON.parse(fs.readFileSync(resultsPath, 'utf-8'))
  : [];

// Build champions data
const divisionOrder = ['feather', 'middle', 'heavy'];
const champions = divisionOrder.map(divisionId => {
  const belt = belts.find((b: any) => b.divisionId === divisionId);
  const division = divisions.find((d: any) => d.id === divisionId);

  if (!belt?.currentChampion) {
    return {
      division,
      belt,
      fighter: null,
      record: null,
      championshipEvent: null
    };
  }

  const fighter = allFighters.find((f: any) => f.id === belt.currentChampion);
  const record = recordsMap.get(belt.currentChampion) || { wins: 0, losses: 0, draws: 0, koWins: 0 };
  const championshipEvent = belt.wonAt ? events.find((e: any) => e.id === belt.wonAt) : null;

  // Build fight history for champion
  const fighterBouts = bouts.filter((bout: any) =>
    bout.fighter1Id === belt.currentChampion || bout.fighter2Id === belt.currentChampion
  );

  const fightHistory = fighterBouts.map((bout: any) => {
    const result = results.find((r: any) => r.boutId === bout.id);
    const event = events.find((e: any) => e.id === bout.eventId);
    const opponentId = bout.fighter1Id === belt.currentChampion ? bout.fighter2Id : bout.fighter1Id;
    const opponent = allFighters.find((f: any) => f.id === opponentId);

    const isWinner = result?.winnerId === belt.currentChampion;
    const score = result?.score || 'N/A';

    let pointsEarned = 0;
    if (isWinner) {
      if (score === '2-0') pointsEarned = 3;
      else if (score === '2-1') pointsEarned = 2;
    } else {
      // Losers can earn points for valiant effort
      if (score === '2-1') {
        pointsEarned = 1; // Valiant effort (1-2 loss)
      }
    }

    return {
      boutId: bout.id,
      eventId: bout.eventId,
      eventTitle: event?.title || 'Unknown Event',
      eventDate: event?.date || '',
      opponentName: opponent ? `${opponent.firstName} ${opponent.lastName}` : 'Unknown',
      opponentNickname: opponent?.nickname,
      isWinner,
      score,
      method: result?.method || 'N/A',
      pointsEarned,
      forChampionship: bout.forChampionship || false,
    };
  }).sort((a: any, b: any) => {
    return new Date(b.eventDate).getTime() - new Date(a.eventDate).getTime();
  });

  return {
    division,
    belt,
    fighter,
    record,
    championshipEvent,
    fightHistory
  };
});

const hasChampions = champions.some(c => c.fighter !== null);

// Build past champions data
const pastChampions: any[] = [];
belts.forEach((belt: any) => {
  if (belt.history && belt.history.length > 0) {
    const division = divisions.find((d: any) => d.id === belt.divisionId);

    belt.history.forEach((reign: any) => {
      const fighter = allFighters.find((f: any) => f.id === reign.fighterId);
      const record = recordsMap.get(reign.fighterId) || { wins: 0, losses: 0, draws: 0, koWins: 0 };
      const wonAtEvent = reign.wonAt ? events.find((e: any) => e.id === reign.wonAt) : null;
      const lostAtEvent = reign.lostAt ? events.find((e: any) => e.id === reign.lostAt) : null;

      pastChampions.push({
        division,
        belt,
        fighter,
        record,
        wonAtEvent,
        lostAtEvent,
        defenses: reign.defenses || 0
      });
    });
  }
});

const hasPastChampions = pastChampions.length > 0;
const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Champions"
  description="Meet the current champions of the Blood & Bourbon Fight League. View title holders across all three divisions: Light Hands, Roughnecks, and Bone Crushers."
>
  <PageHeader title="Champions" subtitle="The title holders of BBFL" />

  <section class="py-16 bg-gradient-to-b from-yellow-50 via-white to-yellow-50">
    <div class="container mx-auto px-4">
      {hasChampions ? (
        <div class="max-w-6xl mx-auto">
          <div class="grid md:grid-cols-3 gap-8">
            {champions.map((champion) => {
              const { division, belt, fighter, record, championshipEvent } = champion;

              if (!fighter) {
                // Vacant title card
                return (
                  <div class="bg-white rounded-2xl shadow-xl overflow-hidden border-4 border-gray-300">
                    <div class="aspect-[3/2] bg-gradient-to-br from-gray-300 to-gray-400 flex items-center justify-center relative">
                      <span class="text-6xl font-black text-white opacity-50">VACANT</span>
                      <div class="absolute top-2 right-2 bg-gray-400 text-gray-700 px-3 py-1 rounded-full text-xs font-black border-2 border-gray-500">
                        NO CHAMPION
                      </div>
                    </div>
                    <div class="p-6 bg-gradient-to-b from-gray-50 to-white">
                      <h3 class="text-2xl font-black text-gray-600 mb-2">{belt.name}</h3>
                      <DivisionChip division={division?.nickname || division?.name} />
                      <p class="text-sm text-gray-500 mt-4 italic">Title currently vacant</p>
                    </div>
                  </div>
                );
              }

              const hasImage = fighter.image && fighter.image !== '/images/fighters/placeholder.jpg';
              const initials = `${fighter.firstName[0]}${fighter.lastName[0]}`.toUpperCase();

              return (
                <a
                  href={`/fighters/${fighter.id}/`}
                  class="group bg-white rounded-2xl shadow-xl overflow-hidden hover:shadow-2xl transition transform hover:scale-105 border-4 border-yellow-400"
                >
                  <div class="aspect-[3/2] overflow-hidden relative bg-gray-100">
                    {hasImage ? (
                      <img
                        src={fighter.image}
                        alt={`${fighter.firstName} ${fighter.lastName}`}
                        class="w-full h-full object-cover object-top group-hover:scale-110 transition-transform duration-300"
                        loading="lazy"
                      />
                    ) : (
                      <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-yellow-400 to-yellow-600">
                        <span class="text-6xl md:text-7xl font-black text-white opacity-90">{initials}</span>
                      </div>
                    )}
                    <div class="absolute top-2 right-2 bg-yellow-400 text-yellow-900 px-3 py-1 rounded-full text-xs font-black border-2 border-yellow-600">
                      CHAMPION
                    </div>
                  </div>
                  <div class="p-6 bg-gradient-to-b from-yellow-50 to-white">
                    <div class="mb-4">
                      <h3 class="text-2xl font-black text-yellow-700 group-hover:text-yellow-800 transition">
                        {fighter.firstName} {fighter.lastName}
                      </h3>
                      {fighter.nickname && (
                        <p class="text-sm text-gray-600 italic">"{fighter.nickname}"</p>
                      )}
                    </div>

                    <div class="flex items-center justify-between mb-3">
                      <RecordBadge wins={record.wins} losses={record.losses} draws={record.draws} />
                      <span class="text-sm text-gray-500">{fighter.weight} lbs</span>
                    </div>

                    <DivisionChip division={division?.nickname || division?.name} />

                    <div class="mt-4 pt-4 border-t border-yellow-200">
                      <div class="text-xs text-gray-600">
                        <div class="flex justify-between mb-1">
                          <span class="font-semibold">Title Defenses:</span>
                          <span>{belt.defenses}</span>
                        </div>
                        {championshipEvent && (
                          <div class="flex justify-between">
                            <span class="font-semibold">Won At:</span>
                            <span class="truncate ml-2">{championshipEvent.title?.replace('BBFL ', '') || championshipEvent.id}</span>
                          </div>
                        )}
                      </div>
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      ) : (
        <div class="max-w-2xl mx-auto text-center">
          <div class="bg-white rounded-2xl shadow-lg p-12 border-2 border-yellow-400">
            <div class="text-6xl mb-4">🏆</div>
            <h2 class="text-3xl font-black text-bourbon mb-4">Championships Coming Soon</h2>
            <p class="text-gray-600 mb-6">
              The inaugural championship bouts are on the horizon. Soon, three warriors will be crowned
              as the first champions across our three divisions.
            </p>
            <p class="text-sm text-gray-500 italic">
              Check the events page for upcoming title fights.
            </p>
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- Champions Journey Section -->
  {hasChampions && (
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4 max-w-6xl">
        <div class="text-center mb-12">
          <h2 class="text-4xl font-black text-bourbon mb-2">Road to Championship</h2>
          <p class="text-gray-600">See how our champions earned their belts</p>
        </div>

        <div class="space-y-12">
          {champions.map((champion) => {
            const { division, belt, fighter, record, fightHistory } = champion;

            if (!fighter || !fightHistory || fightHistory.length === 0) return null;

            return (
              <div class="bg-gradient-to-br from-yellow-50 to-white rounded-2xl shadow-lg overflow-hidden border-2 border-yellow-400">
                <!-- Champion Header -->
                <div class="bg-gradient-to-r from-yellow-400 to-yellow-500 text-yellow-900 p-6">
                  <div class="flex items-center justify-between">
                    <div>
                      <h3 class="text-2xl font-black mb-1">
                        <a href={`/fighters/${fighter.id}/`} class="hover:text-yellow-800 transition">
                          {fighter.firstName} {fighter.lastName}
                        </a>
                      </h3>
                      <p class="text-sm font-semibold">{belt.name}</p>
                    </div>
                    <div class="text-right">
                      <RecordBadge wins={record.wins} losses={record.losses} draws={record.draws} />
                    </div>
                  </div>
                </div>

                <!-- Fight History -->
                <div class="p-6">
                  <h4 class="text-lg font-bold text-bourbon mb-4">Fight History</h4>
                  <div class="space-y-3">
                    {fightHistory.map((fight: any) => (
                      <div class="bg-white rounded-lg p-4 border-2 border-gray-200 hover:border-yellow-400 transition">
                        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3">
                          <!-- Event & Opponent -->
                          <div class="flex-1">
                            <div class="flex items-center gap-2 mb-1">
                              <span class="text-xs font-semibold text-gray-500">{fight.eventTitle?.replace('BBFL ', '')}</span>
                              {fight.forChampionship && (
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-bold bg-yellow-100 text-yellow-800 border border-yellow-300">
                                  TITLE FIGHT
                                </span>
                              )}
                            </div>
                            <p class="text-sm font-bold text-gray-900">
                              vs {fight.opponentName}
                              {fight.opponentNickname && (
                                <span class="text-xs text-gray-500 font-normal ml-1">"{fight.opponentNickname}"</span>
                              )}
                            </p>
                          </div>

                          <!-- Result -->
                          <div class="flex items-center gap-3">
                            <div class={`px-3 py-1 rounded font-bold text-xs ${
                              fight.isWinner
                                ? 'bg-green-100 text-green-800 border border-green-300'
                                : 'bg-red-100 text-red-800 border border-red-300'
                            }`}>
                              {fight.isWinner ? 'WIN' : 'LOSS'}
                            </div>
                            <div class="text-center">
                              <p class="text-lg font-black text-bourbon">{fight.score}</p>
                              <p class="text-xs text-gray-500">{fight.method}</p>
                            </div>
                            <div class="text-center bg-gray-50 rounded px-3 py-1 border border-gray-200 min-w-[60px]">
                              <p class={`text-lg font-black ${fight.pointsEarned > 0 ? 'text-green-600' : 'text-gray-400'}`}>
                                {fight.pointsEarned > 0 ? '+' : ''}{fight.pointsEarned}
                              </p>
                              <p class="text-xs text-gray-500">pts</p>
                            </div>
                          </div>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- Championship History Section -->
  {hasChampions && (
    <section class="py-16 bg-gray-50">
      <div class="container mx-auto px-4 max-w-4xl">
        <h2 class="text-3xl font-black text-center mb-8 text-bourbon">Championship Lineage</h2>
        <div class="bg-parchment rounded-2xl shadow-lg p-8 border-2 border-bourbon">
          <p class="text-gray-700 text-center">
            The history of BBFL championships is written in blood and bourbon. Each title represents
            the pinnacle of achievement in their respective division.
          </p>
          <div class="mt-6 grid md:grid-cols-3 gap-6">
            {champions.map((champion) => {
              const { division, belt } = champion;
              return (
                <div class="text-center">
                  <h3 class="font-bold text-bourbon mb-2">{belt.name}</h3>
                  <div class="text-sm text-gray-600">
                    <p>Division: {division?.nickname}</p>
                    <p class="text-xs mt-1 text-gray-500">{division?.description}</p>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Past Champions Section -->
  {hasPastChampions && (
    <section class="py-16 bg-gray-50">
      <div class="container mx-auto px-4 max-w-6xl">
        <div class="text-center mb-12">
          <h2 class="text-4xl font-black text-bourbon mb-2">Past Champions</h2>
          <p class="text-gray-600">Legends who held BBFL gold</p>
        </div>

        <div class="space-y-8">
          {pastChampions.map((past) => {
            const { division, belt, fighter, record, wonAtEvent, lostAtEvent, defenses } = past;

            if (!fighter) return null;

            const hasImage = fighter.image && fighter.image !== '/images/fighters/placeholder.jpg';
            const initials = `${fighter.firstName[0]}${fighter.lastName[0]}`.toUpperCase();

            return (
              <div class="bg-white rounded-xl shadow-lg overflow-hidden border-2 border-gray-300 hover:shadow-xl transition">
                <div class="md:flex">
                  <!-- Fighter Image -->
                  <div class="md:w-48 aspect-square md:aspect-auto overflow-hidden relative bg-gray-100">
                    <a href={`/fighters/${fighter.id}/`} class="block h-full">
                      {hasImage ? (
                        <img
                          src={fighter.image}
                          alt={`${fighter.firstName} ${fighter.lastName}`}
                          class="w-full h-full object-cover object-top hover:scale-110 transition-transform duration-300"
                          loading="lazy"
                        />
                      ) : (
                        <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-gray-400 to-gray-600">
                          <span class="text-6xl font-black text-white opacity-90">{initials}</span>
                        </div>
                      )}
                    </a>
                  </div>

                  <!-- Champion Details -->
                  <div class="flex-1 p-6">
                    <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
                      <div class="flex-1">
                        <div class="flex items-center gap-3 mb-2">
                          <h3 class="text-2xl font-black text-gray-800">
                            <a href={`/fighters/${fighter.id}/`} class="hover:text-bourbon transition">
                              {fighter.firstName} {fighter.lastName}
                            </a>
                          </h3>
                          <span class="px-3 py-1 bg-gray-200 text-gray-700 text-xs font-bold rounded-full border border-gray-400">
                            FORMER CHAMPION
                          </span>
                        </div>
                        {fighter.nickname && (
                          <p class="text-sm text-gray-600 italic mb-3">"{fighter.nickname}"</p>
                        )}

                        <div class="mb-4">
                          <h4 class="font-bold text-bourbon mb-1">{belt.name}</h4>
                          <div class="flex items-center gap-2">
                            <DivisionChip division={division?.nickname || division?.name} />
                            <span class="text-sm text-gray-500">{fighter.weight} lbs</span>
                          </div>
                        </div>

                        <div class="grid grid-cols-2 gap-4 mb-4">
                          <div>
                            <p class="text-xs text-gray-500 uppercase font-semibold mb-1">Won Title</p>
                            <p class="text-sm font-bold text-green-700">
                              {wonAtEvent ? wonAtEvent.title?.replace('BBFL ', '') : 'Unknown'}
                            </p>
                            {wonAtEvent && (
                              <p class="text-xs text-gray-500">
                                {new Date(wonAtEvent.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                              </p>
                            )}
                          </div>
                          <div>
                            <p class="text-xs text-gray-500 uppercase font-semibold mb-1">Lost Title</p>
                            <p class="text-sm font-bold text-red-700">
                              {lostAtEvent ? lostAtEvent.title?.replace('BBFL ', '') : 'Vacated'}
                            </p>
                            {lostAtEvent && (
                              <p class="text-xs text-gray-500">
                                {new Date(lostAtEvent.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                              </p>
                            )}
                          </div>
                        </div>
                      </div>

                      <div class="text-right">
                        <RecordBadge wins={record.wins} losses={record.losses} draws={record.draws} />
                        <div class="mt-3 pt-3 border-t border-gray-200">
                          <p class="text-xs text-gray-500 uppercase font-semibold">Title Defenses</p>
                          <p class="text-3xl font-black text-bourbon">{defenses}</p>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
