---
// Import SVG assets as raw strings
import TreeSVG from '../assets/christmas/tree-corner.svg?raw';
import WreathSVG from '../assets/christmas/wreath.svg?raw';
import HollySVG from '../assets/christmas/holly.svg?raw';

// Import Christmas CSS
import '../styles/christmas-snow.css';
import '../styles/christmas-lights.css';
import '../styles/christmas-elements.css';
import '../styles/christmas-interactive.css';
---

<!-- Snow Container with 20 animated snowflakes -->
<div class="christmas-snow" aria-hidden="true">
  {Array.from({ length: 20 }).map(() => (
    <div class="snowflake"></div>
  ))}
</div>

<!-- Christmas Lights String (positioned in header via CSS) -->
<div class="christmas-lights" aria-hidden="true">
  {Array.from({ length: 18 }).map((_, i) => (
    <span class="light" style={`animation-delay: ${(i * 0.15).toFixed(2)}s`}></span>
  ))}
</div>

<!-- Corner Christmas Trees -->
<div class="christmas-tree christmas-tree-left" aria-hidden="true" set:html={TreeSVG} />
<div class="christmas-tree christmas-tree-right" aria-hidden="true" set:html={TreeSVG} />

<!-- Wreath in Header -->
<div class="christmas-wreath" aria-hidden="true" set:html={WreathSVG} />

<!-- Holly decorations and snow buildup (will be injected via JavaScript) -->
<script define:vars={{ HollySVG }}>
  // Wait for DOM to be ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initChristmasElements);
  } else {
    initChristmasElements();
  }

  function initChristmasElements() {
    addHolly();
    addSnowBuildup();
  }

  function addHolly() {
    const footerText = document.querySelector('footer p:first-child');
    if (footerText && HollySVG) {
      // Create left holly
      const hollyLeft = document.createElement('span');
      hollyLeft.className = 'christmas-holly christmas-holly-left';
      hollyLeft.innerHTML = HollySVG;
      hollyLeft.setAttribute('aria-hidden', 'true');

      // Create right holly
      const hollyRight = document.createElement('span');
      hollyRight.className = 'christmas-holly christmas-holly-right';
      hollyRight.innerHTML = HollySVG;
      hollyRight.setAttribute('aria-hidden', 'true');

      // Insert holly elements
      footerText.insertBefore(hollyLeft, footerText.firstChild);
      footerText.appendChild(hollyRight);
    }
  }

  function addSnowBuildup() {
    // Find the hero section (first section on homepage with gradient background)
    const heroSection = document.querySelector('section.relative.bg-gradient-to-br');

    if (heroSection) {
      // Make sure hero section has position relative
      heroSection.style.position = 'relative';

      // Create snow buildup element
      const snowBuildup = document.createElement('div');
      snowBuildup.className = 'snow-buildup';
      snowBuildup.setAttribute('aria-hidden', 'true');

      // Append to hero section
      heroSection.appendChild(snowBuildup);
    }
  }

  // Christmas cursor trail effect
  let lastSparkleTime = 0;
  const sparkleInterval = 50; // milliseconds between sparkles
  const sparkleTypes = ['star', 'snow', 'red', 'green'];

  // Check if user prefers reduced motion
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!prefersReducedMotion) {
    document.addEventListener('mousemove', (e) => {
      const now = Date.now();

      // Throttle sparkle creation
      if (now - lastSparkleTime < sparkleInterval) return;
      lastSparkleTime = now;

      // Create sparkle
      const sparkle = document.createElement('div');
      sparkle.className = `cursor-sparkle ${sparkleTypes[Math.floor(Math.random() * sparkleTypes.length)]}`;

      // Position at cursor
      sparkle.style.left = e.pageX + 'px';
      sparkle.style.top = e.pageY + 'px';

      // Random drift direction
      const tx = (Math.random() - 0.5) * 30;
      const ty = (Math.random() - 0.5) * 30 - 15; // Slight upward bias
      sparkle.style.setProperty('--tx', `${tx}px`);
      sparkle.style.setProperty('--ty', `${ty}px`);

      document.body.appendChild(sparkle);

      // Remove after animation completes
      setTimeout(() => {
        sparkle.remove();
      }, 1500);
    });
  }
</script>
